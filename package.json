{
  "name": "snowflakes",
  "private": true,
  "description": "Share photos of snowflakes and swipe through them. Free, no ads.",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev --port 8788",
    "deploy": "node tools/deploy.mjs",
    "db:local": "wrangler d1 execute snowflakes --local --file=schema.sql",
    "db:remote": "wrangler d1 execute snowflakes --remote --file=schema.sql",
    "test": "node --test tests/unit/*.test.mjs && playwright test",
    "test:unit": "node --test tests/unit/*.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "wrangler": "^4"
  }
}
